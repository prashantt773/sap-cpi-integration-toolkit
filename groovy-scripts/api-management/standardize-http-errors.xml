<!--
  SAP API Management / Apigee FaultRule Policy Snippet
  Purpose: Normalizes backend HTTP 4xx/5xx fault responses into a consistent 
  JSON error envelope without leaking internal gateway stack details.
-->
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-Standardize-Error-Response">
    <DisplayName>Standardize Error Response</DisplayName>
    <Set>
        <Headers>
            <Header name="Content-Type">application/json</Header>
        </Headers>
        <Payload contentType="application/json">
{
  "error": {
    "code": "{error.status.code}",
    "message": "{error.reason.phrase}",
    "correlationId": "{messageid}",
    "timestamp": "{system.timestamp}"
  }
}
        </Payload>
        <StatusCode>{error.status.code}</StatusCode>
        <ReasonPhrase>{error.reason.phrase}</ReasonPhrase>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
